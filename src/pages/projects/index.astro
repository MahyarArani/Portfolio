---
import { getCollection } from 'astro:content';
import EntryListItem from '../../components/EntryListItem.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { repoMaterials } from '../../lib/githubMaterials';
import { isProject, siteMeta, sortEntries } from '../../lib/site';

const entries = sortEntries((await getCollection('projects')).filter(isProject));
---

<SiteLayout title={`Projects | ${siteMeta.name}`}>
  <section class="page-hero">
    <div class="shell">
      <span class="eyebrow">Projects</span>
      <h1 class="page-title">Analytics, data science, and agentic AI systems.</h1>
      <p class="lede">
        Applied work across analytics engineering, machine learning, forecasting, BI, geospatial analytics, and agentic
        AI-assisted workflows. Each entry emphasizes the problem, data approach, modeling or system design, and
        decision-support value.
      </p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell collection-banner">
      <div>
        <span class="eyebrow">Project Portfolio</span>
        <h2>Applied analytics case studies</h2>
      </div>
      <p>
        Data products, dashboards, forecasting systems, classification studies, geospatial analysis, and agentic workflow
        tools supported by selected public and private repository materials.
      </p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell section-head">
      <div>
        <span class="eyebrow">Repository Materials</span>
        <h2 class="section-title">Code, dashboards, and working systems</h2>
      </div>
      <p class="section-caption">
        Public repositories are linked directly. Private materials are summarized only at a capability level.
      </p>
    </div>

    <div class="shell repo-grid">
      {repoMaterials.map((repo) => (
        <article class="repo-card">
          <div class="repo-card-head">
            <span class="eyebrow-tag">{repo.category}</span>
            <span class="repo-visibility">{repo.visibility}</span>
          </div>
          <h3>{repo.href ? <a href={repo.href}>{repo.name}</a> : repo.name}</h3>
          <p>{repo.summary}</p>
          <div class="pill-row">
            {repo.stack.map((item) => <span class="metric-chip">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell entry-list">
      {entries.map((entry) => <EntryListItem entry={entry} />)}
    </div>
  </section>
</SiteLayout>
