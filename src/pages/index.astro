---
import { getCollection } from 'astro:content';
import EntryListItem from '../components/EntryListItem.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getFeatured, isResearch, siteMeta, sortEntries } from '../lib/site';
import { about } from '../lib/about';
import { repoMaterials } from '../lib/githubMaterials';

const entries = sortEntries(await getCollection('projects'));
const researchEntries = entries.filter(isResearch);
const featured = getFeatured(entries);
const featuredRepos = repoMaterials.slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<SiteLayout title={`${siteMeta.name} | Portfolio`}>

  <!-- ─── Personal intro ─────────────────────────────────────────────────── -->
  <section class="intro-section">
    <div class="shell intro-inner">

      <div class="intro-text">
        <span class="eyebrow">Portfolio</span>
        <h1 class="intro-name">{about.greeting}</h1>
        <p class="intro-role">{about.role}</p>
        <p class="intro-bio">{about.bio}</p>
        <div class="pill-row">
          {about.skills.map((skill) => <span class="skill-chip">{skill}</span>)}
        </div>
        <div class="intro-actions">
          <a href={`${base}projects/`} class="button-link">View Projects</a>
          <a href={`${base}about/`} class="button-link-muted">About Me</a>
          <a href={about.linkedin} class="button-link-muted">LinkedIn</a>
          <a href={`mailto:${about.email}`} class="button-link-muted">Contact</a>
        </div>
      </div>

      <div class="intro-card">
        <div class="intro-card-header">
          <div class="intro-avatar">{about.name.split(' ').map((n: string) => n[0]).join('')}</div>
          <div>
            <strong class="intro-card-name">{about.name}</strong>
            <span class="intro-card-sub">Analytics · Data Science · Agentic AI</span>
          </div>
        </div>

        <div class="intro-focus">
          {about.focusAreas.map((area) => (
            <div class="intro-focus-item">
              <strong>{area.title}</strong>
              <span>{area.desc}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section class="section">
    <div class="shell section-head">
      <div>
        <span class="eyebrow">Technical Materials</span>
        <h2 class="section-title">Repository-backed analytics work</h2>
      </div>
      <a href={`${base}projects/`} class="button-link-muted">View materials</a>
    </div>
    <div class="shell repo-grid">
      {featuredRepos.map((repo) => (
        <article class="repo-card">
          <div class="repo-card-head">
            <span class="eyebrow-tag">{repo.category}</span>
            <span class="repo-visibility">{repo.visibility}</span>
          </div>
          <h3>{repo.href ? <a href={repo.href}>{repo.name}</a> : repo.name}</h3>
          <p>{repo.summary}</p>
          <div class="pill-row">
            {repo.stack.map((item) => <span class="metric-chip">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ─── Selected Projects ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="shell section-head">
      <div>
        <span class="eyebrow">Applied Analytics</span>
        <h2 class="section-title">Data products and model systems</h2>
      </div>
      <a href={`${base}projects/`} class="button-link-muted">See all →</a>
    </div>
    <div class="shell entry-list">
      {featured.map((entry) => <EntryListItem entry={entry} />)}
    </div>
  </section>

  <!-- ─── Research ─────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="shell section-head">
      <div>
        <span class="eyebrow">Agentic AI Research</span>
        <h2 class="section-title">Benchmarks, publications, and risk studies</h2>
      </div>
      <a href={`${base}research/`} class="button-link-muted">All research →</a>
    </div>
    <div class="shell entry-list">
      {researchEntries.slice(0, 3).map((entry) => <EntryListItem entry={entry} />)}
    </div>
  </section>

</SiteLayout>
