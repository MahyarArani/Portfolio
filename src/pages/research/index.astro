---
import { getCollection } from 'astro:content';
import EntryListItem from '../../components/EntryListItem.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { currentResearchMaterials } from '../../lib/githubMaterials';
import { isResearch, siteMeta, sortEntries } from '../../lib/site';

const entries = sortEntries((await getCollection('projects')).filter(isResearch));
const base = import.meta.env.BASE_URL;
---

<SiteLayout title={`Research | ${siteMeta.name}`}>
  <section class="page-hero">
    <div class="shell">
      <span class="eyebrow">Research</span>
      <h1 class="page-title">Agentic AI, financial risk, and analytics research.</h1>
      <p class="lede">
        Published research and selected working projects across agentic AI evaluation, temporal leakage, financial replay,
        mortgage credit risk, and applied analytics.
      </p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell collection-banner">
      <div>
        <span class="eyebrow">Research Portfolio</span>
        <h2>Publications and active research</h2>
      </div>
      <p>
        Peer-reviewed and conference work is listed alongside private research systems summarized at a public-facing level.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell quote-band" style="margin-bottom: 1.25rem;">
      <p>
        The research portfolio connects data science with evaluation design: how to build benchmarks, avoid leakage,
        measure model behavior, and reason about AI systems in financial and organizational settings.
      </p>
    </div>

    <div class="shell repo-grid" style="margin-bottom: 1.25rem;">
      {currentResearchMaterials.map((item) => (
        <article class="repo-card">
          <span class="eyebrow-tag">Current Research</span>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>

    <div class="shell entry-list">
      {entries.map((entry) => <EntryListItem entry={entry} />)}
    </div>

    <div class="shell" style="margin-top: 1.25rem;">
      <div class="mosaic-card">
        <img src={`${base}google-sites/images/Papers/deecf8d3a0ef17ae1fb752e12112e0eb.jpg`} alt="Research section visual" />
        <div class="mosaic-caption">
          <strong>Research portfolio</strong>
          <span>Papers, frameworks, and analytical studies across multiple domains.</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
